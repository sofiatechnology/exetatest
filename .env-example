# General Settings

ADMIN_SECRET=11bdfs455-b2bf-40c1-a7d4-4068b461d6d5
BASE_URL=http://localhost:9080
APP_NAME=EXETATEST
APP_URL=http://localhost:5173
JWT_SECRET=change-me-in-production
OTP_PEPPER=change-me-otp-pepper

# DATABASES

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=1234
DB_NAME=exetatest

# Frontend URL
FRONTEND_URL=http://localhost:4200

# Email Configuration
# smtp-resend (default) = Nodemailer primary, Resend fallback on failure
# smtp / nodemailer     = Nodemailer only
# resend                = Resend only
EMAIL_PROVIDER=smtp-resend

# Absolute URL to logo.png for email clients (optional).
# Defaults to ${BASE_URL}/email-assets/logo.png
# EMAIL_ASSETS_URL=https://your-cdn.example.com/logo.png

# Primary: Nodemailer / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=user@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@yourdomain.com

# Fallback: Resend (used when Nodemailer fails)
RESEND_API_KEY=re_xxxxxxxxxxxxx
FROM_EMAIL=hello@mail.yourdomain.com
EMAIL_REPLY_TO=support@yourdomain.com
SUPPORT_EMAIL=support@yourdomain.com

# Resend webhook signing secret (whsec_...) from Resend dashboard
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# Optional dedicated secret for unsubscribe link HMAC
UNSUBSCRIBE_SECRET=change-me-unsubscribe-secret

# Email From Address (legacy fallback)
EMAIL_FROM=noreply@user.com

# Throttling (global defaults; OTP endpoints use stricter limits)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# SCRIPT COMMAND


# deployment

```bash
ADMIN_SECRET="your-admin-secret" BASE_URL="https://your-app.example.com" ./make-admin.sh user@example.com
```

# link to generate app password

https://myaccount.google.com/apppasswords
